<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <RootNamespace>MPRSG6Z</RootNamespace> <!-- Keep original root namespace -->
    <AssemblyName>AmpDll</AssemblyName>
    <OutputPath>..\Build\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo> <!-- Assuming Properties\AssemblyInfo.cs contains custom attributes -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AmpConfigDll\AmpConfigDll.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Ports" Version="6.0.0" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="6.0.0" />
  </ItemGroup>

  <!-- System.Deployment and System.Drawing might need to be added as FrameworkReferences or PackageReferences if used.
       For .NET 6, System.Drawing.Common NuGet package is needed for System.Drawing.
       System.Deployment is generally not applicable to .NET Core/6.0 libraries.
       I'll omit them for now and add if build errors indicate they are needed. -->

</Project>